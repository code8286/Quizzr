{
  "name": "mathematics-quiz-3",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config=playwright.ui.config.ts",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "verify": "npm test && npm run test:e2e && npm run test:production && npm run build && npm run typecheck",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "demo": "tsx scripts/setup.ts demo",
    "setup:admin": "tsx scripts/setup.ts admin",
    "papers:import": "tsx scripts/setup.ts papers",
    "class:import": "tsx scripts/import-class.ts"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "katex": "^0.18.10",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.56.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
